---
import Base from '../layouts/Base.astro';
import GearDashboard from '../components/GearDashboard.svelte';
import { getValidTokens } from '../lib/session';
import { getUsage } from '../lib/apiUsage';
import { readUnits } from '../lib/preferences';

const tokens = await getValidTokens(Astro.cookies);
if (!tokens) {
  return Astro.redirect('/');
}

const units = readUnits(Astro.cookies);
const usage = getUsage(Astro.cookies);
---

<Base title="Dashboard">
	<GearDashboard
		client:load
		athleteId={tokens.athleteId}
		firstname={tokens.firstname}
		units={units}
		initialUsageRemaining={usage.remaining}
		usageLimit={usage.limit}
	/>
</Base>
